{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "endOfLine": "lf",
  "arrowParens": "always",
  "bracketSpacing": true,
  "importOrder": [
    "^react$",
    "^react-dom$",
    "^react-dom/(.*)$",
    "^react-router-dom$",
    "<THIRD_PARTY_MODULES>",
    "",
    "^app/(.*)$",
    "^entities/(.*)$",
    "^features/(.*)$",
    "^pages/(.*)$",
    "^widgets/(.*)$",
    "^shared/(.*)$",
    "",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "jsx"],
  "plugins": ["@ianvs/prettier-plugin-sort-imports"]
}
